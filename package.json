{
  "name": "real-time-ai-assistant",
  "version": "2.0.0",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "build": "next build",
    "start": "electron .",
    "lint": "next lint",
    "electron": "node run-electron.js",
    "dev:desktop": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cueai.teleprompter",
    "productName": "CueAI Teleprompter",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "ai-engine.js",
      "whisper-stt.js",
      "screenCapture.js",
      "resume-context.js",
      ".env.local",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      ".next/**/*",
      "node_modules/next/**/*",
      "node_modules/react/**/*",
      "node_modules/react-dom/**/*",
      "node_modules/@swc/helpers/**/*",
      "node_modules/screenshot-desktop/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/sharp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "latest",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@swc/helpers": "^0.5.23",
    "@vercel/og": "^1.0.2",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "framer-motion": "^13.1.1",
    "get-port": "^7.2.0",
    "groq-sdk": "^1.6.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "node-microphone": "^0.2.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "screenshot-desktop": "^1.15.6",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "wavefile": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
