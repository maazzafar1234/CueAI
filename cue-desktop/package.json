{
  "name": "cue-desktop",
  "version": "2.0.0",
  "description": "Undetectable Real-Time AI Teleprompter Desktop Application",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "groq-sdk": "^1.6.0",
    "node-microphone": "^0.2.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^7.5.0",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^5.1.0",
    "wavefile": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cueai.teleprompter",
    "productName": "CueAI Teleprompter",
    "asar": true,
    "directories": {
      "output": "dist-clean"
    },
    "files": [
      "**/*",
      "!**/node_modules/@xenova/transformers/.cache/**/*",
      "!**/node_modules/**/*.onnx",
      "!**/node_modules/**/*.onnx_data",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/test/**/*",
      "!**/node_modules/**/tests/**/*",
      "!**/node_modules/**/docs/**/*"
    ],
    "extraResources": [
      ".env.local"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "CueAI-Teleprompter-v2.0.0.exe"
    }
  }
}
